<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- The header: its backdrop fades from one team's colour to the other's (set in code). -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="@dimen/touch"
                android:layout_height="@dimen/touch"
                android:background="@drawable/bg_row"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/league"
                style="@style/Text.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/homeBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <app.scoreline.ui.widget.CrestView
                    android:id="@+id/homeCrest"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/homeName"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>

            <!-- Grows with the clock pill rather than clipping it; at least as tall as a crest so
                 the score sits level with them. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="76dp"
                android:minWidth="128dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/score"
                    style="@style/Text.Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/clock"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:drawablePadding="6dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/awayBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <app.scoreline.ui.widget.CrestView
                    android:id="@+id/awayCrest"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/awayName"
                    style="@style/Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/raceTitle"
            style="@style/Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textSize="26sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/summary"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <app.scoreline.ui.widget.ProgressLine
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="6dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="28dp"
            android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/island"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/bg_btn_tonal"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:textColor="@color/on_primary_container"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/momentsTitle"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/moments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/bg_card_plain"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/venue"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <TextView
            android:id="@+id/open"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_outline"
            android:drawableEnd="@drawable/ic_open"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:text="@string/open_espn"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
