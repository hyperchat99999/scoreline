<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="@dimen/touch"
                android:layout_height="@dimen/touch"
                android:background="@drawable/bg_row"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>

        <TextView
            style="@style/Text.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="@string/set_island"
            android:textColor="@color/primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/bg_card_plain"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <Switch
                android:id="@+id/auto"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Switch
                android:id="@+id/comps"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <Switch
                android:id="@+id/alerts"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/gutter"
            android:background="@drawable/bg_card_plain"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/background"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:drawableStart="@drawable/ic_bolt"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/notifications"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:drawableStart="@drawable/ic_bell"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/set_notifications" />

            <TextView
                android:id="@+id/following"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/set_following" />
        </LinearLayout>

        <TextView
            style="@style/Text.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:text="@string/set_about"
            android:textColor="@color/primary" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/set_about_body"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/version"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp" />
    </LinearLayout>
</ScrollView>
