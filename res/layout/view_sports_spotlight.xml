<?xml version="1.0" encoding="utf-8"?>
<!-- The match spotlight: a broadcast-style card washed in both teams' colours, with a sport watermark,
     crests on team-colour discs and a full-card takeover for goals, wickets and other big moments. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card" android:clipToOutline="true">
    <!-- Sport watermark, bled off the bottom-right corner. -->
    <ImageView android:id="@+id/spotlightScene" android:layout_width="168dp" android:layout_height="168dp" android:layout_gravity="end|bottom"
        android:layout_marginEnd="-36dp" android:layout_marginBottom="-40dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <View android:id="@+id/spotlightAccent" android:layout_width="match_parent" android:layout_height="3dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="18dp" android:paddingBottom="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false">
            <ImageView android:id="@+id/spotlightSport" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/spotlightLeague" style="@style/Text.Overline" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" />
            <TextView android:id="@+id/spotlightStatus" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="26dp"
                android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="11dp" android:maxLines="1"
                android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06" android:fontFeatureSettings="tnum" />
        </LinearLayout>
        <LinearLayout android:id="@+id/spotlightBody" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:id="@+id/spotlightBoard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false">
                        <app.scoreline.ui.widget.CrestView android:id="@+id/spotlightHomeCrest" android:layout_width="52dp" android:layout_height="52dp" android:padding="9dp" android:background="@drawable/bg_spotlight_crest" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/spotlightHomeName" style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                        <TextView android:id="@+id/spotlightHomeScore" style="@style/Text.Score" android:layout_width="84dp" android:layout_height="wrap_content"
                            android:gravity="end|center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" android:textSize="38sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="10dp">
                        <app.scoreline.ui.widget.CrestView android:id="@+id/spotlightAwayCrest" android:layout_width="52dp" android:layout_height="52dp" android:padding="9dp" android:background="@drawable/bg_spotlight_crest" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/spotlightAwayName" style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
                        <TextView android:id="@+id/spotlightAwayScore" style="@style/Text.Score" android:layout_width="84dp" android:layout_height="wrap_content"
                            android:gravity="end|center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" android:textSize="38sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/spotlightScore" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/spotlightRace" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/spotlightRaceTitle" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/spotlightRaceOrder" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingMultiplier="1.2" android:textSize="14sp" android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>
            <!-- Before kick-off: the start time, set big like a scoreboard. -->
            <LinearLayout android:id="@+id/spotlightArtPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/spotlightPhase" style="@style/Text.Score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:maxLines="1" android:textSize="30sp" />
                <TextView android:id="@+id/spotlightPhaseCaption" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/spotlightProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp"
            android:layout_marginTop="16dp" android:progressDrawable="@drawable/spotlight_progress" android:indeterminate="false" android:importantForAccessibility="no" android:visibility="gone" />
        <LinearLayout android:id="@+id/spotlightFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="8dp">
            <TextView android:id="@+id/spotlightFreshness" style="@style/Text.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" />
            <TextView android:id="@+id/spotlightOpen" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="4dp" android:background="@drawable/bg_row" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="4dp" android:text="@string/spotlight_open" />
        </LinearLayout>
    </LinearLayout>
    <!-- The takeover: a goal or wicket floods the card in the moment's colour for about a second. -->
    <FrameLayout android:id="@+id/spotlightFlash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="invisible" android:alpha="0" android:importantForAccessibility="no">
        <ImageView android:id="@+id/spotlightFlashArt" android:layout_width="190dp" android:layout_height="190dp" android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="-40dp" android:alpha="0.18" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_spotlight_flash_disc">
                <ImageView android:id="@+id/spotlightEventArt" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp"
                    android:scaleType="fitCenter" android:alpha="0" android:visibility="invisible" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
                <TextView android:id="@+id/spotlightFlashWord" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white"
                    android:textSize="44sp" android:fontFamily="sans-serif-condensed" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
                <TextView android:id="@+id/spotlightFlashScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="@android:color/white" android:alpha="0.9" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:fontFeatureSettings="tnum" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
